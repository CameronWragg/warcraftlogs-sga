{
  "name": "sga",
  "image": "ghcr.io/astral-sh/uv:trixie-slim",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "UV_PYTHON_INSTALL_DIR": "/home/vscode/.local/share/uv/python"
  },
  "postCreateCommand": "uv sync && uv run pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
